export interface Team {
  id: number;
  name: string;
  players: string;
}

export interface TTScheduleEvent {
  day: number;
  date: string;
  match1: string;
  match2: string;
  winner1?: string;
  winner2?: string;
  status: 'completed' | 'upcoming';
}

export interface CarromScheduleEvent {
  day: number;
  date: string;
  match: string;
  winner?: string;
  status: 'completed' | 'upcoming';
}

export interface TTScore {
  id: number;
  teamNo: string;
  played: number;
  winSet: number;
  loseSet: number;
  matchPoint: number;
  score: number;
}

export interface CarromScore {
  id: number;
  teamNo: string;
  played: number;
  win: number;
  lose: number;
  score: number;
}

